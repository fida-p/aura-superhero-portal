# =====================================================
# AURA — Guardian of Voices | Backend environment vars
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. It is git-ignored.
# Only placeholders go here — no real credentials.
# =====================================================

# Port the Express server listens on
PORT=5000

# Allowed frontend origin(s) for CORS (comma-separated). Uses the
# Vite dev server URL by default.
FRONTEND_URL=http://localhost:5173

# =====================================================
# EMAIL (Resend HTTP API — port 443, works on hosts
# like Render Free that block outbound SMTP ports)
# =====================================================
# Create a free API key at https://resend.com/api-keys
# and paste it ONLY into backend/.env (local) or the
# Render Dashboard (production). Never commit it.
RESEND_API_KEY=

# Sender identity. With a free Resend account you must use
# the test sender until you verify a domain:
#   AURA Portal <onboarding@resend.dev>
# After verifying your own domain, switch to e.g.
#   AURA Portal <noreply@yourdomain.com>
MAIL_FROM=AURA Portal <onboarding@resend.dev>

# Recipient of help-request notifications
MAIL_TO=