# =====================================================
# AURA — Guardian of Voices | Backend environment vars
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. It is git-ignored.
# Only placeholders go here — no real credentials.
# =====================================================

# Port the Express server listens on
PORT=5000

# Allowed frontend origin(s) for CORS (comma-separated). Uses the
# Vite dev server URL by default.
FRONTEND_URL=http://localhost:5173

# =====================================================
# EMAIL (Nodemailer SMTP transport)
# =====================================================
# For Gmail you would normally use an "App Password" as SMTP_PASS.
# Or point SMTP_HOST at your provider's SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# From / To for the automatic help-request notification
MAIL_FROM=AURA Portal <noreply@example.com>
MAIL_TO=